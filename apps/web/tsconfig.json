{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "public/dist",
    "rootDir": "src",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@qooqnos/i18n": [
        "packages/i18n/dist/index.d.ts"
      ],
      "@qooqnos/commerce": [
        "packages/commerce/dist/index.d.ts"
      ]
    }
  },
  "references": [
    {
      "path": "../../packages/commerce"
    }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
