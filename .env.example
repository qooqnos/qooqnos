# Phoenix Intelligence Environment Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database & Storage
# DATABASE_URL=
# GEMINI_API_KEY=

# SEO & Search Engine Gateways
SEO_CANONICAL_BASE_URL=http://localhost:3000
SEO_INDEXNOW_KEY=
SEO_BING_API_KEY=
SEO_GSC_SITE_URL=
SEO_GSC_ACCESS_TOKEN=
SEO_GOOGLE_PLACES_API_KEY=
SEO_GOOGLE_ROUTES_API_KEY=

# AI Provider Configuration
# Set to arvan-aiaas to use Arvan AIaaS explicitly.
# AI_PROVIDER_ID=arvan-aiaas
# AI_SELLER_EXTRACT_MODEL_ID=DeepSeek-R1-qwen-7b-awq
# AI_SELLER_EXTRACT_MODEL_VERSION=1
# ARVAN_AI_ENDPOINT=https://<your-endpoint>
# ARVAN_AI_API_KEY=
# ARVAN_AI_MAX_TOKENS=3000
# ARVAN_AI_TEMPERATURE=0.2
# ARVAN_AI_REGION=IR
# Provider token prices are configured in IRR minor units per 1M tokens.
# Copy the current Arvan AIaaS model price into deployment configuration.
# ARVAN_AI_INPUT_PRICE_PER_1M_IRR=
# ARVAN_AI_OUTPUT_PRICE_PER_1M_IRR=
# 5000 basis points = 50% customer markup over Arvan provider cost.
# ARVAN_AI_MARKUP_BPS=5000
# ARVAN_AI_PRICING_VERSION=arvan-config-v1
# AI_WORKER_ID=
